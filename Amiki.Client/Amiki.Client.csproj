<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>false</OverrideHtmlAssetPlaceholders>
    <RootNamespace>Amiki</RootNamespace>
    <!-- PWA: lists every app file with its hash, so the service worker can cache (and verify) them. -->
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
  </PropertyGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" PrivateAssets="all" />
    <PackageReference Include="MudBlazor" Version="9.10.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Amiki.Domain\Amiki.Domain.csproj" />
    <ProjectReference Include="..\Amiki.Contracts\Amiki.Contracts.csproj" />
  </ItemGroup>

  <!-- The shared domain and wire types, used all over the app. -->
  <ItemGroup>
    <Using Include="Amiki.Domain" />
    <Using Include="Amiki.Domain.Assistant" />
    <Using Include="Amiki.Domain.Diary" />
    <Using Include="Amiki.Domain.Finance" />
    <Using Include="Amiki.Domain.Ideas" />
    <Using Include="Amiki.Domain.Inbox" />
    <Using Include="Amiki.Domain.People" />
    <Using Include="Amiki.Domain.Review" />
    <Using Include="Amiki.Domain.Tasks" />
    <Using Include="Amiki.Domain.Wishlist" />
    <Using Include="Amiki.Contracts" />
    <Using Include="Amiki.Contracts.Assistant" />
    <Using Include="Amiki.Contracts.People" />
  </ItemGroup>

</Project>
