@* One message: yours on the right, Amiki's on the left with what she looked at underneath. *@

<div class="@($"chat-msg {(Line.FromAmiki ? "amiki" : "me")}")">
    @if (Line.FromAmiki)
    {
        <span class="chat-avatar" aria-hidden="true"><MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" Size="Size.Small" /></span>
    }
    <div class="chat-body">
        <div class="chat-bubble">@Line.Text</div>
        @foreach (var proposal in Line.Proposals ?? [])
        {
            <ProposalCard @key="proposal.Id" Proposal="proposal" />
        }
        @if (Footer is { Length: > 0 } footer)
        {
            <div class="chat-looked">@footer</div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ChatLine Line { get; set; } = default!;

    // "Looked at tasks · 5.2 s": what she checked, and how long the reply took.
    private string Footer => string.Join(" · ", new[]
    {
        Line.Looked is { Count: > 0 } looked ? $"Looked at {string.Join(", ", looked)}" : null,
        Line.Seconds is { } seconds ? $"{seconds.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)} s" : null,
    }.Where(part => part is not null));
}
