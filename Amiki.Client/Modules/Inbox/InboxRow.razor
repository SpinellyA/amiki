@inject InboxTriage Triage

<div class="inbox-row">
    <div class="inbox-main">
        <div class="inbox-text">@Item.Text</div>
        <div class="task-meta"><span>@When.Short(Item.CapturedAt)</span></div>
        @* "Not sure" shows nothing: the buttons on the right already cover sorting it yourself. *@
        @if (Suggestion is { Kind: not TriageKind.Unsure } suggestion)
        {
            <SuggestionChip Suggestion="suggestion" OnAccept="() => Triage.Accept(Item, suggestion)"
                            OnAdjust="() => Triage.AdjustAsync(Item, suggestion)" />
        }
        else if (Thinking)
        {
            <div class="suggestion thinking"><MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" Size="Size.Small" /> Thinking…</div>
        }
    </div>
    <div class="inbox-actions">
        <MudTooltip Text="Make it a task">
            <MudIconButton Icon="@Icons.Material.Outlined.TaskAlt" Size="Size.Small" Color="Color.Primary"
                           aria-label="Make it a task" OnClick="() => Triage.ToTaskAsync(Item)" />
        </MudTooltip>
        <MudTooltip Text="Keep as an idea">
            <MudIconButton Icon="@Icons.Material.Outlined.Lightbulb" Size="Size.Small" Color="Color.Warning"
                           aria-label="Keep as an idea" OnClick="() => Triage.ToIdea(Item)" />
        </MudTooltip>
        <MudTooltip Text="Discard">
            <MudIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small"
                           aria-label="Discard" OnClick="() => Triage.Discard(Item)" />
        </MudTooltip>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public InboxItem Item { get; set; } = default!;

    /// <summary>Amiki's guess for this note, if there is one.</summary>
    [Parameter] public TriageSuggestion? Suggestion { get; set; }

    /// <summary>A guess is on its way.</summary>
    [Parameter] public bool Thinking { get; set; }
}
