@*
    Floating "+" on every page: jot something into the Inbox without leaving what you're doing.
    Hidden on the Inbox page itself, which already has a capture field at the top, and on the
    Amiki chat, where it would sit on top of the send button.
*@
@implements IDisposable
@inject NavigationManager Nav
@inject IDialogService Dialogs

@if (!Hidden)
{
    <MudTooltip Text="Quick capture to Inbox" Placement="Placement.Left" RootClass="quick-capture">
        <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" aria-label="Quick capture to Inbox" OnClick="Open" />
    </MudTooltip>
}

@code {
    private bool Hidden => Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimEnd('/') is "inbox" or "amiki";

    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;
    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    private Task Open() => Dialogs.ShowAsync<QuickCaptureDialog>("Quick capture", new DialogOptions
    {
        MaxWidth = MaxWidth.Small,
        FullWidth = true,
        CloseOnEscapeKey = true,
        Position = DialogPosition.TopCenter,
    });
}
