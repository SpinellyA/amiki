@* The category's icon as a button; clicking it opens a grid of icons to choose from. *@

<MudMenu @ref="_menu" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" Disabled="Disabled">
    <ActivatorContent>
        <button type="button" class="tx-icon cat-icon-button @(Income ? "income" : "")" disabled="@Disabled"
                aria-label="Change icon" title="@(Disabled ? null : "Change icon")">
            <MudIcon Icon="@CategoryIcons.Get(Value)" Size="Size.Small" />
        </button>
    </ActivatorContent>
    <ChildContent>
        <div class="icon-grid" role="listbox" aria-label="Icons">
            @foreach (var (key, icon) in CategoryIcons.All)
            {
                <MudIconButton Icon="@icon" Size="Size.Small" aria-label="@key" role="option" aria-selected="@(key == Value)"
                               Class="@(key == Value ? "icon-choice picked" : "icon-choice")"
                               OnClick="() => PickAsync(key)" />
            }
        </div>
    </ChildContent>
</MudMenu>

@code {
    [Parameter] public string Value { get; set; } = CategoryIcons.Default;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public bool Income { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private MudMenu? _menu;

    private async Task PickAsync(string key)
    {
        if (_menu is not null) await _menu.CloseMenuAsync();
        await ValueChanged.InvokeAsync(key);
    }
}
