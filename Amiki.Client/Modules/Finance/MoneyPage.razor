@page "/money"
@implements IDisposable
@inject FinanceStore Store
@inject FinanceActions Actions

<PageTitle>Money · Amiki</PageTitle>

<div class="page-head">
    <div>
        <MudText Typo="Typo.body2" Class="muted">Total balance</MudText>
        <div class="hero-figure">@Signed(Store.TotalBalance)</div>
    </div>
    <div class="head-actions">
        <ViewSwitch Views="FinanceModule.Views" Current="money" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.SwapHoriz"
                   OnClick="() => Actions.MoveAsync()">Move money</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.FactCheck"
                   OnClick="() => Actions.CheckBalancesAsync()">Check balances</MudButton>
    </div>
</div>

<div class="accounts">
    @foreach (var account in Store.Accounts)
    {
        var last = Store.LastCheck(account.Name);
        <MudMenu AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" Class="account-menu">
            <ActivatorContent>
                <MudPaper Outlined="true" Class="account-card" role="button" aria-label="@($"{account.Name} options")">
                    <span class="stat-label">@account.Name</span>
                    <span class="account-value @(Store.Balance(account.Name) < 0 ? "neg" : "")">@Signed(Store.Balance(account.Name))</span>
                    <span class="account-check @(last is null || DateTime.Now - last.CheckedAt > FinanceAudit.StaleAfter ? "stale" : "")">
                        @if (last is null)
                        {
                            @:not checked yet
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" /> @($"checked {When.Day(last.CheckedAt).ToLowerInvariant()}")
                        }
                    </span>
                </MudPaper>
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem Icon="@Icons.Material.Filled.SwapHoriz" OnClick="() => Actions.MoveAsync(from: account.Name)">Move money from @account.Name</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.FactCheck" OnClick="() => Actions.CheckBalancesAsync(account.Name)">Check @account.Name's balance</MudMenuItem>
            </ChildContent>
        </MudMenu>
    }
</div>

<FinanceAuditPanel />

<QuickEntry />

<div class="month-bar">
    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" aria-label="Previous month"
                   OnClick="() => ChangeMonth(-1)" />
    <span class="cal-title">@_month.ToString("MMMM yyyy")</span>
    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" aria-label="Next month"
                   OnClick="() => ChangeMonth(1)" Disabled="_month >= ThisMonth" />
</div>

<MudGrid Spacing="3">
    <MudItem xs="12" md="7">
        <MudStack Spacing="3">
            <MudPaper Outlined="true" Class="widget">
                <div class="stat-row pt-0">
                    <div class="stat"><span class="stat-value">@Money.Format(_spent)</span><span class="stat-label">spent</span></div>
                    <div class="stat"><span class="stat-value">@Money.Format(_received)</span><span class="stat-label">received</span></div>
                    <div class="stat">
                        <span class="stat-value">@Money.Signed(_received - _spent)</span>
                        <span class="stat-label">@(_received >= _spent ? "saved" : "overspent")</span>
                    </div>
                </div>
                <MudText Typo="Typo.caption" Class="muted px-4 d-block">Moving money between your accounts isn't counted; its fees are. Balance fixes aren't counted.</MudText>
            </MudPaper>

            <MudPaper Outlined="true" Class="widget">
                <div class="widget-head">
                    <MudIcon Icon="@Icons.Material.Outlined.DonutSmall" Size="Size.Small" />
                    <span>Where it went</span>
                    <MudSpacer />
                    <span class="muted widget-hint">Click a category to filter</span>
                </div>
                <div class="px-4 pt-3 pb-2">
                    <CategoryBars Transactions="_flows" @bind-Selected="_category" />
                </div>
            </MudPaper>

            <MudPaper Outlined="true" Class="widget">
                <div class="widget-head">
                    <MudIcon Icon="@Icons.Material.Outlined.BarChart" Size="Size.Small" />
                    <span>Spending per day</span>
                </div>
                <div class="px-4 pt-3 pb-2">
                    <DailySpending Month="_month" Transactions="_flows" />
                </div>
            </MudPaper>
        </MudStack>
    </MudItem>

    <MudItem xs="12" md="5">
        <MudPaper Outlined="true" Class="widget">
            <div class="widget-head">
                <MudIcon Icon="@Icons.Material.Outlined.ReceiptLong" Size="Size.Small" />
                <span>Transactions</span>
                <MudSpacer />
                @if (_category is not null)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined"
                             OnClose="() => _category = null">@_category</MudChip>
                }
            </div>
            @{ var shown = Entries().ToList(); }
            @if (shown.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="muted px-4 py-3">Nothing logged in @_month.ToString("MMMM").</MudText>
            }
            @foreach (var day in shown.GroupBy(e => e.Date.Date).OrderByDescending(g => g.Key))
            {
                <div class="tx-day">
                    <span>@When.Day(day.Key)</span>
                    <span class="muted">@Money.Signed(day.Sum(e => e.NetChange))</span>
                </div>
                @foreach (var entry in day.OrderByDescending(e => e.CreatedAt))
                {
                    if (entry.Transfer is { } transfer)
                    {
                        <TransferRow @key="transfer.Id" Item="transfer" OnEdit="t => Actions.MoveAsync(t)" OnDelete="Actions.DeleteTransferWithUndo" />
                    }
                    else if (entry.Transaction is { } tx)
                    {
                        <TransactionRow @key="tx.Id" Item="tx" OnEdit="t => Actions.EditAsync(t)" OnDelete="Actions.DeleteWithUndo" />
                    }
                }
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private static DateTime ThisMonth => new(DateTime.Today.Year, DateTime.Today.Month, 1);

    /// <summary>A line in the list: either a transaction or a transfer.</summary>
    private sealed record Entry(DateTime Date, DateTime CreatedAt, decimal NetChange, Transaction? Transaction = null, Transfer? Transfer = null);

    private DateTime _month = ThisMonth;
    private string? _category;
    private List<Transaction> _flows = [];
    private decimal _spent, _received;

    protected override void OnInitialized()
    {
        Store.Changed += OnChanged;
        Refresh();
    }

    public void Dispose() => Store.Changed -= OnChanged;

    private void OnChanged()
    {
        Refresh();
        InvokeAsync(StateHasChanged);
    }

    private void ChangeMonth(int delta)
    {
        _month = _month.AddMonths(delta);
        _category = null;
        Refresh();
    }

    private void Refresh()
    {
        _flows = Store.FlowsInMonth(_month).ToList();
        _spent = _flows.Where(t => t.Kind == TxKind.Expense).Sum(t => t.Amount);
        _received = _flows.Where(t => t.Kind == TxKind.Income).Sum(t => t.Amount);
    }

    // Filtering by "Fees" shows the transfers that had one; any other category shows its transactions.
    private IEnumerable<Entry> Entries() =>
        Store.InMonth(_month)
            .Where(t => _category is null || t.Category == _category)
            .Select(t => new Entry(t.Date, t.CreatedAt, t.Signed, Transaction: t))
            .Concat(Store.TransfersInMonth(_month)
                .Where(t => _category is null || (_category == Categories.Fees && t.Fee > 0))
                .Select(t => new Entry(t.Date, t.CreatedAt, -t.Fee, Transfer: t)));

    private static string Signed(decimal v) => (v < 0 ? "−" : "") + Money.Format(v);
}
