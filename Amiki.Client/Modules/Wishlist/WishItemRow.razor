@* One wishlist item: name, price, how close you are, and what you can do with it. *@
@inject WishlistActions Actions

<div class="wish-row @(Item.IsOpen ? "" : "wish-done")">
    @if (CanMove)
    {
        <div class="wish-order">
            <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp" Size="Size.Small" Disabled="IsFirst"
                           aria-label="@($"Move {Item.Name} up")" OnClick="() => Actions.Move(Item, -1)" />
            <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" Disabled="IsLast"
                           aria-label="@($"Move {Item.Name} down")" OnClick="() => Actions.Move(Item, 1)" />
        </div>
    }
    <div class="wish-main">
        <div class="wish-name">
            @Item.Name
            @if (Item.Link is { } link)
            {
                <MudIconButton Href="@link" Target="_blank" Rel="noopener noreferrer" Icon="@Icons.Material.Outlined.OpenInNew"
                               Size="Size.Small" aria-label="@($"Open the link for {Item.Name}")" Class="wish-link" />
            }
        </div>
        @if (Item.Note.Length > 0)
        {
            <div class="muted wish-note">@Item.Note</div>
        }
        @if (Item.IsOpen)
        {
            var afford = Item.Against(Pool);
            @if (Item.Saved > 0 || Item.Status == WishStatus.Saving)
            {
                <div class="wish-afford @(Item.Remaining == 0 ? "ok" : "")">
                    <div class="wish-meter" aria-hidden="true"><span style="width: @Percent(Item.Progress)"></span></div>
                    <span>@(Item.Remaining == 0 ? "Fully saved" : $"{Money.Format(Item.Saved)} of {Money.Format(Item.Price)} saved")</span>
                </div>
            }
            @if (Item.PaceOn(DateTime.Today) is { } pace)
            {
                <div class="muted wish-note">
                    @(pace.IsLate
                        ? $"Wanted by {Item.TargetDate:MMM d}: {Money.Format(pace.Remaining)} still to go"
                        : $"{Money.Format(pace.PerWeek)}/week to have it by {Item.TargetDate:MMM d}")
                </div>
            }
            @if (Item.Remaining > 0)
            {
                <div class="muted wish-note @(afford.CanAfford ? "wish-covered" : "")">
                    @(afford.CanAfford ? "Wishlist money covers the rest" : $"{Money.Format(afford.Short)} more wishlist money needed")
                </div>
            }
        }
        else if (Item.BoughtAt is { } bought)
        {
            <div class="muted wish-note">Bought @When.Day(bought).ToLowerInvariant()@(Item.TransactionId is null ? "" : " · logged in Money")</div>
        }
    </div>
    <div class="wish-price">
        @Money.Format(Item.Price)
        @if (Item.PreviousPrice is { } was && Item.IsOpen)
        {
            <span class="wish-was @(was > Item.Price ? "down" : "up")" title="@($"Was {Money.Format(was)}")">was @Money.Format(was)</span>
        }
    </div>
    <div class="wish-actions">
        @if (Item.IsOpen)
        {
            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Outlined.ShoppingBag"
                       OnClick="() => Actions.BuyAsync(Item)">Bought it</MudButton>
        }
        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                 aria-label="@($"More for {Item.Name}")">
            @if (Item.IsOpen)
            {
                <MudMenuItem Icon="@Icons.Material.Outlined.Savings" OnClick="() => Actions.PutTowardAsync(Item)">Put money toward it</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Outlined.ShowChart" OnClick="() => OnPlan.InvokeAsync(Item)">Plan it in What if</MudMenuItem>
            }
            <MudMenuItem Icon="@Icons.Material.Outlined.Edit" OnClick="() => Actions.EditAsync(Item)">Edit</MudMenuItem>
            @foreach (var status in WishStatusLook.Order.Where(s => s != Item.Status && s != WishStatus.Bought))
            {
                <MudMenuItem Icon="@WishStatusLook.Icon(status)" OnClick="() => Actions.SetStatus(Item, status)">Move to @WishStatusLook.Name(status)</MudMenuItem>
            }
            <MudMenuItem Icon="@Icons.Material.Outlined.Delete" OnClick="() => Actions.DeleteWithUndo(Item)">Remove</MudMenuItem>
        </MudMenu>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public WishItem Item { get; set; } = default!;

    /// <summary>Wishlist money not put toward anything (and still really in your accounts).</summary>
    [Parameter] public decimal Pool { get; set; }

    /// <summary>Show up/down arrows (saving-for items, which have an order).</summary>
    [Parameter] public bool CanMove { get; set; }
    [Parameter] public bool IsFirst { get; set; }
    [Parameter] public bool IsLast { get; set; }

    /// <summary>"Plan it in What if" was picked.</summary>
    [Parameter] public EventCallback<WishItem> OnPlan { get; set; }

    private static string Percent(double share) => (share * 100).ToString("0", System.Globalization.CultureInfo.InvariantCulture) + "%";
}
