@page "/wishlist"
@implements IDisposable
@inject WishlistStore Store
@inject FinanceStore Money
@inject WishlistActions Actions
@inject PlanStore Plans
@inject NavigationManager Nav

<PageTitle>Wishlist · Amiki</PageTitle>

<div class="page-head">
    <div>
        <MudText Typo="Typo.h4">Wishlist</MudText>
        <MudText Typo="Typo.body2" Class="muted">Things you'd like to buy, against the money you've set aside for them.</MudText>
    </div>
    <div class="head-actions">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="() => Actions.EditAsync()">Add item</MudButton>
    </div>
</div>

@if (Store.All.Count == 0)
{
    <div class="empty">
        <MudIcon Icon="@Icons.Material.Outlined.FavoriteBorder" Size="Size.Large" />
        <MudText Typo="Typo.body1">Nothing on your wishlist yet.</MudText>
        <MudText Typo="Typo.body2">Add the things you're eyeing, with their prices, and see what they'd do to your balance.</MudText>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="() => Actions.EditAsync()">Add the first one</MudButton>
    </div>
}
else
{
    <div class="wish-summary">
        <MudPaper Outlined="true" Class="wish-stat">
            <span class="stat-label">Total balance</span>
            <span class="wish-stat-value">@Amiki.Domain.Finance.Money.Format(Summary.Balance)</span>
            <span class="muted wish-stat-note">All your accounts, as they are.</span>
        </MudPaper>
        <MudPaper Outlined="true" Class="wish-stat wish-fund">
            <span class="stat-label">
                Wishlist money
                <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" Class="wish-fund-edit"
                               aria-label="Set wishlist money" OnClick="Actions.SetFundAsync" />
            </span>
            @if (Store.HasFund)
            {
                <span class="wish-stat-value">@Amiki.Domain.Finance.Money.Format(Summary.SetAside)</span>
                <span class="muted wish-stat-note">@FundLine</span>
                @if (Summary.Overcommitted)
                {
                    <span class="wish-warn">More than your accounts hold right now: only @Amiki.Domain.Finance.Money.Format(Math.Max(0, Summary.Balance)) of it is really there.</span>
                }
            }
            else
            {
                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="wish-fund-start"
                           OnClick="Actions.SetFundAsync">Set some aside</MudButton>
                <span class="muted wish-stat-note">Your wishlist is weighed against this, not your whole balance.</span>
            }
        </MudPaper>
        <MudPaper Outlined="true" Class="wish-stat">
            <span class="stat-label">Saving for</span>
            <span class="wish-stat-value">@Amiki.Domain.Finance.Money.Format(Summary.SavingFor)</span>
            <span class="muted wish-stat-note">@AfterLine(Summary.AfterSaving)</span>
        </MudPaper>
        <MudPaper Outlined="true" Class="wish-stat">
            <span class="stat-label">Everything open</span>
            <span class="wish-stat-value">@Amiki.Domain.Finance.Money.Format(Summary.SavingFor + Summary.Wanted)</span>
            <span class="muted wish-stat-note">@AfterLine(Summary.AfterEverything)</span>
        </MudPaper>
    </div>

    @foreach (var status in WishStatusLook.Order)
    {
        var items = Store.InStatus(status).ToList();
        if (items.Count == 0) continue;
        var closed = status is WishStatus.Bought or WishStatus.Skipped;
        <MudPaper Outlined="true" Class="widget wish-section">
            <div class="widget-head" role="@(closed ? "button" : null)" @onclick="() => Toggle(status, closed)">
                <MudIcon Icon="@WishStatusLook.Icon(status)" Size="Size.Small" />
                <span>@WishStatusLook.Name(status)</span>
                <span class="muted wish-count">@items.Count · @Amiki.Domain.Finance.Money.Format(items.Sum(i => i.Price))</span>
                <MudSpacer />
                @if (closed)
                {
                    <MudIcon Icon="@(IsShown(status) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Size="Size.Small" />
                }
                else if (status == WishStatus.Saving && Summary.TopAffordable > 0)
                {
                    <span class="wish-hint wish-covered">@TopLine</span>
                }
                else
                {
                    <span class="muted wish-hint">@WishStatusLook.Hint(status)</span>
                }
            </div>
            @if (!closed || IsShown(status))
            {
                @for (var i = 0; i < items.Count; i++)
                {
                    var item = items[i];
                    <WishItemRow @key="item.Id" Item="item" Pool="Summary.Pool" OnPlan="PlanIt"
                                 CanMove="status == WishStatus.Saving && items.Count > 1" IsFirst="i == 0" IsLast="i == items.Count - 1" />
                }
            }
        </MudPaper>
    }
}

@code {
    // Bought and Skipped start folded away: they're history, not the point of the page.
    private readonly HashSet<WishStatus> _shown = [];

    private WishlistSummary Summary => Actions.Summary;

    private string FundLine => Summary.SavedInItems > 0
        ? $"{Amiki.Domain.Finance.Money.Format(Summary.SavedInItems)} put toward items · {Amiki.Domain.Finance.Money.Format(Summary.Fund)} free"
        : Store.Fund.IncomeShare is { } share ? $"Free to put toward anything · {share}% of each income adds to it" : "Free to put toward anything.";

    private string TopLine => Summary.TopAffordable == Summary.SavingInOrder.Count
        ? "Wishlist money covers all of these"
        : $"Wishlist money covers your top {Summary.TopAffordable}";

    // A What if plan for this purchase, opened right away.
    private void PlanIt(WishItem item) =>
        Nav.NavigateTo($"money/plan?plan={Plans.PlanPurchase(item.Name, item.Price, item.TargetDate).Id}");

    protected override void OnInitialized()
    {
        Store.Changed += OnChanged;
        Money.Changed += OnChanged;
    }

    public void Dispose()
    {
        Store.Changed -= OnChanged;
        Money.Changed -= OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private bool IsShown(WishStatus status) => _shown.Contains(status);

    private void Toggle(WishStatus status, bool closed)
    {
        if (!closed) return;
        if (!_shown.Remove(status)) _shown.Add(status);
    }

    private static string AfterLine(Affordability after) => after.CanAfford
        ? $"{Amiki.Domain.Finance.Money.Format(after.LeftAfter)} of wishlist money left if you buy it all"
        : $"{Amiki.Domain.Finance.Money.Format(after.Short)} more wishlist money needed";
}
