@page "/ideas"
@implements IDisposable
@inject IdeaStore Store
@inject TaskStore Tasks
@inject IdeaActions Actions

<PageTitle>Ideas · Amiki</PageTitle>

<div class="page-head">
    <div>
        <MudText Typo="Typo.h4">Ideas</MudText>
        <MudText Typo="Typo.body2" Class="muted">
            @Count(IdeaStatus.Parked) parked · @Count(IdeaStatus.InProgress) in progress · @Count(IdeaStatus.Done) done.
            Make a task from an idea to start it; finishing its tasks finishes the idea.
        </MudText>
    </div>
</div>

<MudTextField T="string" @bind-Value="_draft" Immediate="true" OnKeyDown="OnKey"
              Placeholder="Jot an idea… #tags optional" Variant="Variant.Outlined"
              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Lightbulb" />

<div class="toolbar">
    <MudChipSet T="string" @bind-SelectedValue="_tag" SelectionMode="SelectionMode.ToggleSelection"
                CheckMark="false" Color="Color.Primary" Variant="Variant.Text" Size="Size.Small">
        @foreach (var tag in Store.Tags)
        {
            <MudChip Value="tag">#@tag</MudChip>
        }
    </MudChipSet>
    <MudSpacer />
    <MudTextField T="string" @bind-Value="_search" Immediate="true" Placeholder="Search" Clearable="true" Margin="Margin.Dense"
                  Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="toolbar-field" />
</div>

@* Phones show one column at a time; this picks which. Hidden on wider screens, where all three fit. *@
<MudToggleGroup T="IdeaStatus" @bind-Value="_phoneColumn" Color="Color.Primary" Size="Size.Small" Outlined="true" Class="idea-column-switch">
    @foreach (var status in Columns)
    {
        <MudToggleItem Value="status" Text="@($"{IdeaStatusLook.Name(status)} {Visible(status).Count()}")" />
    }
</MudToggleGroup>

<div class="idea-board">
    @foreach (var status in Columns)
    {
        var ideas = Visible(status).ToList();
        <section class="@ColumnClass(status)" aria-label="@IdeaStatusLook.Name(status)"
                 @ondragenter="() => _dropTarget = status" @ondragover:preventDefault="true" @ondrop="() => Drop(status)">
            <div class="group-head idea-column-head">
                <MudIcon Icon="@IdeaStatusLook.Icon(status)" Size="Size.Small" />
                <span>@IdeaStatusLook.Name(status)</span>
                <span class="muted">@ideas.Count</span>
            </div>
            @if (ideas.Count == 0)
            {
                <div class="idea-column-empty muted">@EmptyText(status)</div>
            }
            @foreach (var idea in ideas)
            {
                <IdeaCard @key="idea.Id" Item="idea" OnTagClick="t => _tag = t"
                          OnDragStart="i => _dragging = i" OnDragEnd="() => { _dragging = null; _dropTarget = null; }" />
            }
        </section>
    }
</div>

@code {
    private static readonly IdeaStatus[] Columns = Enum.GetValues<IdeaStatus>();

    private string _draft = "";
    private string? _tag;
    private string? _search;
    private IdeaStatus _phoneColumn = IdeaStatus.Parked;
    private Idea? _dragging;
    private IdeaStatus? _dropTarget;

    protected override void OnInitialized()
    {
        Store.Changed += OnChanged;
        Tasks.Changed += OnChanged;
    }

    public void Dispose()
    {
        Store.Changed -= OnChanged;
        Tasks.Changed -= OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private int Count(IdeaStatus status) => Store.All.Count(i => i.Status == status);

    private IEnumerable<Idea> Visible(IdeaStatus status) => Store.All
        .Where(i => i.Status == status)
        .Where(i => _tag is null || i.Tags.Contains(_tag))
        .Where(i => string.IsNullOrWhiteSpace(_search) || i.ToEditableText().Contains(_search, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(i => i.CreatedAt);

    private string ColumnClass(IdeaStatus status) =>
        "idea-column"
        + (status == _phoneColumn ? " phone-shown" : "")
        + (_dragging is not null && _dropTarget == status && _dragging.Status != status ? " drop-target" : "");

    private static string EmptyText(IdeaStatus status) => status switch
    {
        IdeaStatus.Parked => "New ideas land here.",
        IdeaStatus.InProgress => "Make a task from an idea, or drag one here.",
        _ => "Finished ideas end up here.",
    };

    private void Drop(IdeaStatus status)
    {
        if (_dragging is { } idea && idea.Status != status) Actions.Move(idea, status);
        _dragging = null;
        _dropTarget = null;
    }

    private void OnKey(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || string.IsNullOrWhiteSpace(_draft)) return;
        Store.Upsert(Idea.Parse(_draft));
        _draft = "";
        _phoneColumn = IdeaStatus.Parked; // so you see it land
    }
}
