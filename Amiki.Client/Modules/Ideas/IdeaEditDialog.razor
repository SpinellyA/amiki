<MudDialog>
    <DialogContent>
        <MudTextField T="string" @bind-Value="Text" Label="Idea" Variant="Variant.Outlined" Lines="5" AutoFocus="true"
                      HelperText="Use #tags anywhere in the text." />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="string.IsNullOrWhiteSpace(Text)"
                   OnClick="() => Dialog.Close(DialogResult.Ok(Text))">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public string Text { get; set; } = "";
}
