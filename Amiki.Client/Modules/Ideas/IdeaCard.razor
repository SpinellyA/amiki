@*
    One idea as a card (Board and Cards layouts): text, tags, the tasks made from it (tick them off
    right here), and the idea menu. Done ideas are trimmed: two lines of text and a one-line task
    summary, since they're finished business.
*@
@inject TaskStore Tasks
@inject TaskActions TaskActions
@inject IdeaActions Actions

<MudPaper Outlined="true" Class="@($"idea-card {Item.Status.ToString().ToLowerInvariant()}")"
          draggable="@(Draggable ? "true" : "false")"
          @ondragstart="() => OnDragStart.InvokeAsync(Item)" @ondragend="() => OnDragEnd.InvokeAsync()">
    @if (ShowStatus)
    {
        <span class="idea-status"><MudIcon Icon="@IdeaStatusLook.Icon(Item.Status)" Size="Size.Small" /> @IdeaStatusLook.Name(Item.Status)</span>
    }
    <div class="idea-text" title="@(IsDone ? Item.Text : null)" @onclick="() => Actions.EditAsync(Item)">@Item.Text</div>

    @if (Linked.Count > 0 && IsDone)
    {
        <div class="idea-tasks-summary muted">
            <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" /> @Linked.Count(t => t.IsDone) of @Linked.Count task@(Linked.Count == 1 ? "" : "s") done
        </div>
    }
    else if (Linked.Count > 0)
    {
        <div class="idea-tasks">
            @foreach (var task in Linked)
            {
                <div class="idea-task @(task.IsDone ? "done" : "")">
                    <MudCheckBox T="bool" Value="task.IsDone" ValueChanged="_ => TaskActions.Toggle(task)" Size="Size.Small"
                                 Color="Color.Primary" aria-label="@($"Done: {task.Title}")" />
                    <span class="idea-task-title" @onclick="() => TaskActions.EditAsync(task)">@task.Title</span>
                </div>
            }
        </div>
    }

    <div class="idea-foot">
        @foreach (var tag in Item.Tags)
        {
            <span class="idea-tag" @onclick="() => OnTagClick.InvokeAsync(tag)">#@tag</span>
        }
        <MudSpacer />
        <span class="muted">@IdeaDates.Label(Item)</span>
        <IdeaMenu Item="Item" />
    </div>
</MudPaper>

@code {
    [Parameter, EditorRequired] public Idea Item { get; set; } = default!;
    [Parameter] public bool ShowStatus { get; set; }
    [Parameter] public bool Draggable { get; set; }
    [Parameter] public EventCallback<string> OnTagClick { get; set; }
    [Parameter] public EventCallback<Idea> OnDragStart { get; set; }
    [Parameter] public EventCallback OnDragEnd { get; set; }

    private bool IsDone => Item.Status == IdeaStatus.Done;

    // Open tasks first, then the finished ones.
    private List<TaskItem> Linked => Tasks.ForIdea(Item.Id).OrderBy(t => t.IsDone).ThenBy(t => t.CreatedAt).ToList();
}
